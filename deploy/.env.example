# DCEMS Server Environment Configuration Example
# Copy this file to .env and replace placeholders with secure secrets.

# Web Server Configuration
DCEMS_HOST=0.0.0.0
DCEMS_PORT=8000
DCEMS_DB_PATH=data/dcems.db

# MQTT Broker Connection
DCEMS_MQTT_BROKER=127.0.0.1
DCEMS_MQTT_PORT=1883
DCEMS_MQTT_USER=dcems_server
DCEMS_MQTT_PASSWORD=dcems_mqtt_secret_password_here

# Security & Authentication
DCEMS_JWT_SECRET=super_secret_signing_key_at_least_32_chars_long
DCEMS_JWT_ALGORITHM=HS256
DCEMS_TOKEN_EXPIRE_MINUTES=480

# Default User Credentials (Seeded on first startup if not already in DB)
DCEMS_ADMIN_USER=admin
DCEMS_ADMIN_PASSWORD=AdminPass_DCEMS_2026!
DCEMS_VIEWER_USER=viewer
DCEMS_VIEWER_PASSWORD=ViewerPass_DCEMS_2026!

# System Settings
DCEMS_ROOM_ID=room1
DCEMS_LOG_LEVEL=INFO
DCEMS_ENABLE_ADAPTIVE_BASELINE=false

